#!/bin/sh
# Starts Kiri's engine after setup or when kiri-win wakes the distro.
# The daemon serves its unix socket; kiri-win carries the Windows docker CLI
# to it over `kiri bridge`.
export HOME=/var/lib/kiri-daemon
mkdir -p "$HOME" /var/log

# WSL's default resolv.conf uses the NAT gateway as nameserver; that host
# frequently does not answer, so every registry pull fails DNS. Prefer public
# resolvers (AliDNS / DNSPod first, then Google) whenever the file still
# points at that gateway, is a WSL-managed symlink, or is missing.
fix_resolv() {
  if [ -L /etc/resolv.conf ] || [ -e /etc/resolv.conf ]; then
    rm -f /etc/resolv.conf
  fi
  printf '%s\n' 'nameserver 223.5.5.5' 'nameserver 119.29.29.29' 'nameserver 8.8.8.8' > /etc/resolv.conf
  chmod 644 /etc/resolv.conf
}
gw=$(ip route 2>/dev/null | awk '/default/ { print $3; exit }')
ns=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)
if [ -L /etc/resolv.conf ] || [ -z "$ns" ] || { [ -n "$gw" ] && [ "$ns" = "$gw" ]; }; then
  fix_resolv
fi

pgrep -f '/usr/local/bin/kiri daemon' >/dev/null 2>&1 && exit 0
rm -f "$HOME/.kiri/run/docker.sock"
nohup /usr/local/bin/kiri daemon >>/var/log/kiri.log 2>&1 &
i=0
while [ "$i" -lt 50 ]; do
  [ -S "$HOME/.kiri/run/docker.sock" ] && exit 0
  sleep 0.1
  i=$((i + 1))
done
echo "kiri daemon did not create its socket; see /var/log/kiri.log" >&2
exit 1
